# Copy to .env — NEVER commit real secrets. Credentials: python -m tko setup
TKO_LIVE_MODE=true
TKO_EXCHANGE_ID=tokocrypto
TKO_BASE_ASSET=BTC
TKO_QUOTE_ASSET=IDR
TKO_QUOTE_ASSETS=IDR,USDT,USDC
TKO_TRADEABLE_BASES=BTC,ETH,BNB,SOL,XRP,ADA,DOGE,AVAX,DOT,LINK
TKO_LOOP_INTERVAL_SEC=60
TKO_MIN_QUOTE_BALANCE=50000
TKO_MIN_QUOTE_BALANCE_USDT=5
TKO_MAX_POSITION_PCT=15
TKO_MAX_ORDER_NOTIONAL=7500000
TKO_MAX_DAILY_NOTIONAL=30000000
TKO_MAX_DAILY_LOSS_PCT=5
TKO_RISK_TIMEZONE=Asia/Jakarta
TKO_TELEGRAM_ENABLED=true
TKO_ML_FILTER_ENABLED=false
